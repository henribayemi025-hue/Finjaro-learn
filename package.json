{
  "name": "app-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:coop": "esbuild src/coop.ts --format=cjs --outfile=.test-build/coop.cjs --log-level=error && node tests/coop.test.cjs",
    "test:exos": "esbuild src/lessons.ts --bundle --platform=node --format=esm --outfile=.test-build/lessons.mjs --log-level=error --define:import.meta.env.BASE_URL='\"/\"' && node tests/exos.test.mjs",
    "test:sqlbase": "esbuild src/lessons.ts --bundle --platform=node --format=esm --outfile=.test-build/lessons.mjs --log-level=error --define:import.meta.env.BASE_URL='\"/\"' && esbuild src/sqlBase.ts --bundle --platform=node --format=esm --outfile=.test-build/sqlbase.mjs --log-level=error && esbuild src/explainError.ts --bundle --platform=node --format=esm --outfile=.test-build/explainerror.mjs --log-level=error && node tests/sqlbase.test.mjs",
    "test:cursus": "esbuild src/cursus.ts --bundle --platform=node --format=esm --outfile=.test-build/cursus.mjs --log-level=error --define:import.meta.env.BASE_URL='\"/\"' && node tests/cursus.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@supabase/supabase-js": "^2.117.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
